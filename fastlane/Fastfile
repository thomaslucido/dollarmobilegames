default_platform(:ios)

platform :ios do
  # Builds one game as its own app (staged by scripts/stage-app.mjs), signs it with
  # cloud-managed signing via the App Store Connect API key, uploads it with its listing and
  # screenshots, and submits it for review with automatic release.
  lane :release do
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )
    project = "ios/App/App.xcodeproj"
    workspace = "ios/App/App.xcworkspace"
    use_ws = File.exist?(File.expand_path("../#{workspace}", __dir__))

    # Make sure the app's privacy manifest is part of the App target.
    require "xcodeproj"
    xproj = Xcodeproj::Project.open(File.expand_path("../#{project}", __dir__))
    app_target = xproj.targets.find { |t| t.name == "App" }
    app_group = xproj.main_group.find_subpath("App", false) || xproj.main_group
    unless app_group.files.any? { |f| f.path == "PrivacyInfo.xcprivacy" }
      ref = app_group.new_reference("PrivacyInfo.xcprivacy")
      app_target.resources_build_phase.add_file_reference(ref)
      xproj.save
    end

    increment_version_number(xcodeproj: project, version_number: ENV.fetch("APP_VERSION"))
    increment_build_number(xcodeproj: project, build_number: ENV.fetch("BUILD_NUMBER"))

    # CI machines have no registered test devices, so Xcode can't make a development
    # profile for a normal signed archive. Instead: archive unsigned, then let the export step
    # sign with a cloud-managed Apple Distribution certificate via the API key.
    root = File.expand_path("..", __dir__)
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} -authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    container = use_ws ? "-workspace #{root}/#{workspace}" : "-project #{root}/#{project}"
    archive = "#{root}/build/App.xcarchive"
    export_dir = "#{root}/build/export"
    sh("rm -rf '#{archive}' '#{export_dir}'")
    sh("xcodebuild archive #{container} -scheme App -configuration Release " \
       "-destination 'generic/platform=iOS' -archivePath '#{archive}' " \
       "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')} CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=''  -quiet")
    plist = "#{root}/build/ExportOptions.plist"
    File.write(plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>#{ENV.fetch('TEAM_ID')}</string>
        <key>signingStyle</key><string>automatic</string>
        <key>destination</key><string>export</string>
        <key>uploadSymbols</key><true/>
        <key>manageAppVersionAndBuildNumber</key><false/>
      </dict></plist>
    PLIST
    sh("xcodebuild -exportArchive -archivePath '#{archive}' -exportPath '#{export_dir}' " \
       "-exportOptionsPlist '#{plist}' #{auth}")
    ipa = Dir["#{export_dir}/*.ipa"].first
    UI.user_error!("Export produced no .ipa") unless ipa

    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      ipa: ipa,
      app_version: ENV.fetch("APP_VERSION"),
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end
